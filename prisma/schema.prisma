generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                               Int                       @id @default(autoincrement())
  full_name                        String?                   @db.VarChar(255)
  last_activity                    DateTime?
  role_name                        String                    @db.VarChar(64)
  role_id                          Int
  referrer_id                      Int?
  mobile                           String?                   @unique @db.VarChar(32)
  email                            String?                   @unique @db.VarChar(255)
  password                         String?                   @db.VarChar(255)
  verified                         Boolean                   @default(false)
  avatar                           String?                   @db.VarChar(255)
  about                            String?                   @db.Text
  country_id                       Int?
  province_id                      Int?
  city_id                          Int?
  district_id                      Int?
  school_id                        Int?
  school_subject_id                Int?
  class_number                     Int?                      @db.UnsignedTinyInt
  class_letter                     String?                   @db.VarChar(8)
  status                           UserStatus                @default(active)
  created_at                       Int
  updated_at                       Int?
  deleted_at                       Int?
  book_bookmarks                   BookBookmark[]            @relation("UserBookBookmarks")
  book_highlights                  BookHighlight[]           @relation("UserBookHighlights")
  book_reading_progress            BookReadingProgress[]     @relation("UserBookReadingProgress")
  granted_course_content_overrides CourseContentOverride[]   @relation("AdminGrantedContentOverrides")
  course_content_overrides         CourseContentOverride[]   @relation("UserContentOverrides")
  credit_launches_curated          CreditLaunch[]            @relation("CreditLaunchCurator")
  created_credit_questions         CreditQuestion[]          @relation("CreditQuestionCreator")
  credit_sessions                  CreditSession[]           @relation("CreditSessionStudent")
  created_credit_topics            CreditTopic[]             @relation("CreditTopicCreator")
  created_credits                  Credit[]                  @relation("CreditCreator")
  created_access_restrictions      LessonAccessRestriction[] @relation("AccessRestrictionCreator")
  lesson_schedules_created         LessonSchedule[]          @relation("LessonScheduleCreator")
  lesson_schedules_as_curator      LessonSchedule[]          @relation("LessonScheduleCurator")
  rating_journal_cells             RatingJournalCell[]       @relation("RatingJournalCellStudent")
  created_rating_journal_columns   RatingJournalColumn[]     @relation("RatingJournalColumnCreator")
  created_rating_journals          RatingJournal[]           @relation("RatingJournalCreator")
  trainer_attempts                 TrainerAttempt[]          @relation("TrainerAttemptUser")
  user_streaks                     user_streaks?
  city                             Region?                   @relation("CityUsers", fields: [city_id], references: [id])
  country                          Region?                   @relation("CountryUsers", fields: [country_id], references: [id])
  district                         Region?                   @relation("DistrictUsers", fields: [district_id], references: [id])
  province                         Region?                   @relation("ProvinceUsers", fields: [province_id], references: [id])
  school                           Region?                   @relation("SchoolUsers", fields: [school_id], references: [id])

  @@index([created_at], map: "idx_users_created_at")
  @@index([class_number], map: "idx_users_class_number")
  @@index([city_id], map: "users_city_id_fkey")
  @@index([country_id], map: "users_country_id_fkey")
  @@index([district_id], map: "users_district_id_fkey")
  @@index([province_id], map: "users_province_id_fkey")
  @@index([school_id], map: "users_school_id_fkey")
  @@map("users")
}

model Role {
  id            Int              @id @default(autoincrement()) @db.UnsignedInt
  name          String           @db.VarChar(64)
  code          String           @unique @default("") @db.VarChar(64)
  description   String?          @db.VarChar(255)
  is_admin      Boolean          @default(false)
  is_system     Boolean          @default(false)
  display_order Int              @default(1000) @db.UnsignedInt
  created_at    Int              @db.UnsignedInt
  updated_at    Int?             @db.UnsignedInt
  permissions   RolePermission[] @relation("RolePermissions")

  @@map("roles")
}

model PermissionGroup {
  id            Int          @id @default(autoincrement()) @db.UnsignedInt
  code          String       @unique @db.VarChar(64)
  name_ru       String       @db.VarChar(128)
  name_kz       String       @db.VarChar(128)
  display_order Int          @db.UnsignedInt
  created_at    Int          @db.UnsignedInt
  permissions   Permission[] @relation("GroupPermissions")

  @@map("permission_groups")
}

model Permission {
  id            Int              @id @default(autoincrement()) @db.UnsignedInt
  group_id      Int              @db.UnsignedInt
  code          String           @unique @db.VarChar(96)
  action        String           @db.VarChar(32)
  name_ru       String           @db.VarChar(128)
  name_kz       String           @db.VarChar(128)
  description   String?          @db.VarChar(255)
  display_order Int              @db.UnsignedInt
  group         PermissionGroup  @relation("GroupPermissions", fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  role_grants   RolePermission[] @relation("PermissionGrants")

  @@index([group_id], map: "idx_permissions_group_id")
  @@map("permissions")
}

model RolePermission {
  role_id       Int        @db.UnsignedInt
  permission_id Int        @db.UnsignedInt
  granted_at    Int        @db.UnsignedInt
  granted_by    Int?       @db.UnsignedInt
  permission    Permission @relation("PermissionGrants", fields: [permission_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  role          Role       @relation("RolePermissions", fields: [role_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([role_id, permission_id])
  @@index([permission_id], map: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model Group {
  id                  Int                       @id @default(autoincrement()) @db.UnsignedInt
  creator_id          Int                       @db.UnsignedInt
  supervisor_id       Int?                      @db.UnsignedInt
  name                String                    @db.VarChar(64)
  status              GroupStatus               @default(inactive)
  content_overrides   CourseContentOverride[]   @relation("GroupContentOverrides")
  credits             Credit[]                  @relation("GroupCredits")
  access_restrictions LessonAccessRestriction[] @relation("GroupAccessRestrictions")
  lesson_schedules    LessonSchedule[]          @relation("LessonScheduleGroup")
  rating_journals     RatingJournal[]           @relation("GroupRatingJournals")
  sales               Sale[]                    @relation("GroupSales")

  @@map("groups")
}

model GroupUser {
  id         Int @id @default(autoincrement())
  user_id    Int @db.UnsignedInt
  group_id   Int @db.UnsignedInt
  created_at Int

  @@map("group_users")
}

model UserReferralCode {
  id         Int      @id @default(autoincrement())
  user_id    Int      @unique @db.UnsignedInt
  code       String   @db.VarChar(6)
  created_at DateTime @default(now())

  @@map("user_referral_code")
}

model Verification {
  id          Int     @id @default(autoincrement())
  user_id     Int?    @db.UnsignedInt
  mobile      String? @db.VarChar(16)
  email       String? @db.VarChar(64)
  code        String  @db.VarChar(6)
  verified_at Int?    @db.UnsignedInt
  expired_at  Int?    @db.UnsignedInt
  created_at  Int

  @@map("verifications")
}

model UserLoginHistory {
  id               Int             @id @default(autoincrement())
  user_id          Int             @db.UnsignedInt
  browser          String?         @db.VarChar(255)
  device           String?         @db.VarChar(255)
  os               String?         @db.VarChar(255)
  ip               String?         @db.VarChar(255)
  country          String?         @db.VarChar(255)
  city             String?         @db.VarChar(255)
  session_id       String          @db.Text
  session_start_at BigInt          @db.UnsignedBigInt
  session_end_at   BigInt?         @db.UnsignedBigInt
  end_session_type SessionEndType?
  created_at       BigInt          @db.UnsignedBigInt

  @@map("user_login_histories")
}

model UserFirebaseSession {
  id         BigInt  @id @default(autoincrement())
  user_id    Int     @db.UnsignedInt
  token      String  @db.Text
  fcm_token  String? @db.Text
  ip         String  @db.VarChar(255)
  created_at Int?
  updated_at Int?

  @@map("user_firebase_sessions")
}

model Region {
  id            Int          @id @default(autoincrement())
  country_id    Int?
  province_id   Int?
  city_id       Int?
  district_id   Int?
  type          RegionType
  created_at    Int          @db.UnsignedInt
  universities  University[] @relation("UniversityCity")
  cityUsers     User[]       @relation("CityUsers")
  countryUsers  User[]       @relation("CountryUsers")
  districtUsers User[]       @relation("DistrictUsers")
  provinceUsers User[]       @relation("ProvinceUsers")
  schoolUsers   User[]       @relation("SchoolUsers")

  @@map("regions")
}

model RegionTranslation {
  id        Int    @id @default(autoincrement())
  region_id Int
  locale    String
  title     String @db.VarChar(255)

  @@unique([region_id, locale])
  @@map("region_translations")
}

model SchoolSubject {
  id         Int  @id @default(autoincrement())
  created_at Int
  updated_at Int?

  @@map("school_subjects")
}

model SchoolSubjectTranslation {
  id                Int    @id @default(autoincrement())
  school_subject_id Int
  locale            String
  title             String @db.VarChar(255)

  @@map("school_subject_translations")
}

model Quizzes {
  id                         Int              @id @default(autoincrement())
  category_id                Int?
  subject_id                 Int?
  price                      Decimal?         @db.Decimal(15, 3)
  is_paid                    Boolean          @default(false)
  access_days                Int?             @db.UnsignedInt
  is_listed                  Boolean          @default(true)
  time                       Int?             @default(0)
  attempt                    Int?
  pass_mark                  Int
  certificate                Boolean
  status                     QuizStatus       @default(active)
  total_mark                 Int?             @db.UnsignedInt
  display_questions_randomly Boolean          @default(false)
  expiry_days                Int?             @db.UnsignedInt
  version                    Int              @default(1)
  created_at                 Int
  updated_at                 Int?
  kind                       QuizKind         @default(test)
  trainer_attempts           TrainerAttempt[] @relation("TrainerAttempts")
  trainer_courses            TrainerCourse[]  @relation("TrainerCourses")
  trainer_settings           TrainerSettings? @relation("TrainerSettings")

  @@index([created_at], map: "idx_quizzes_created_at")
  @@index([kind], map: "idx_quizzes_kind")
  @@index([subject_id], map: "idx_quizzes_subject_id")
  @@map("quizzes")
}

model QuizTranslation {
  id      Int    @id @default(autoincrement())
  quiz_id Int    @db.UnsignedInt
  locale  String
  title   String @db.Text

  @@map("quiz_translations")
}

model QuizCategory {
  id               Int     @id @default(autoincrement())
  parent_id        Int?
  subject_id       Int?
  created_at       Int?
  updated_at       Int?
  background_image String? @db.VarChar(512)

  @@map("quiz_categories")
}

model QuizCategoryTranslation {
  id               Int    @id @default(autoincrement())
  quiz_category_id Int
  locale           String
  title            String @db.VarChar(255)

  @@map("quiz_category_translations")
}

model QuizSubject {
  id         Int    @id @default(autoincrement())
  created_at Int?
  updated_at Int?
  books      Book[] @relation("QuizSubjectBooks")

  @@map("quiz_subjects")
}

model QuizSubjectTranslation {
  id              Int    @id @default(autoincrement())
  quiz_subject_id Int
  locale          String
  title           String @db.VarChar(255)

  @@map("quiz_subject_translations")
}

model QuizQuestion {
  id                        Int                      @id @default(autoincrement())
  quiz_id                   Int                      @db.UnsignedInt
  grade                     Int
  answer_video_url          String?                  @db.VarChar(255)
  type                      QuizQuestionType         @default(single)
  image                     String?                  @db.Text
  video                     String?                  @db.Text
  order                     Int?                     @db.UnsignedInt
  created_at                Int
  updated_at                Int?
  trainer_attempt_questions TrainerAttemptQuestion[] @relation("TrainerQuestionProvenance")

  @@map("quizzes_questions")
}

model QuizQuestionTranslation {
  id                  Int     @id @default(autoincrement())
  quizzes_question_id Int     @db.UnsignedInt
  locale              String  @db.Char(255)
  title               String  @db.Text
  description         String? @db.Text
  correct             String? @db.Text

  @@map("quiz_question_translations")
}

model QuizQuestionAnswer {
  id              Int                  @id @default(autoincrement())
  question_id     Int                  @db.UnsignedInt
  parent_id       Int?                 @db.UnsignedInt
  match_target_id Int?
  image           String?              @db.Text
  correct         Boolean              @default(false)
  created_at      Int
  updated_at      Int?
  match_target    QuizQuestionAnswer?  @relation("AnswerMatchTarget", fields: [match_target_id], references: [id], onUpdate: Restrict)
  matched_by      QuizQuestionAnswer[] @relation("AnswerMatchTarget")

  @@index([match_target_id], map: "quizzes_questions_answers_match_target_id_fkey")
  @@map("quizzes_questions_answers")
}

model QuizQuestionAnswerTranslation {
  id                          Int    @id @default(autoincrement())
  quizzes_questions_answer_id Int    @db.UnsignedInt
  locale                      String
  title                       String @db.Text

  @@map("quizzes_questions_answer_translations")
}

model QuizResult {
  id                    Int              @id @default(autoincrement())
  webinar_id            Int?             @db.UnsignedInt
  quiz_id               Int              @db.UnsignedInt
  quiz_version_at_start Int?
  user_id               Int              @db.UnsignedInt
  results               String?          @db.Text
  user_grade            Int?             @db.UnsignedInt
  status                QuizResultStatus @default(waiting)
  created_at            Int

  @@index([user_id, quiz_id, status], map: "idx_quiz_results_lookup")
  @@map("quizzes_results")
}

model TrainerSettings {
  quiz_id              Int             @id
  timer_enabled        Boolean         @default(false)
  seconds_per_question Int?            @db.UnsignedInt
  shuffle_answers      Boolean         @default(false)
  available_from       Int?            @db.UnsignedInt
  available_to         Int?            @db.UnsignedInt
  flashcards_enabled   Boolean         @default(true)
  background_image     String?         @db.VarChar(512)
  theme_id             Int?
  created_at           Int             @db.UnsignedInt
  updated_at           Int?            @db.UnsignedInt
  quiz                 Quizzes         @relation("TrainerSettings", fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "trainer_settings_quiz_id_fkey")
  theme                TrainerTheme?   @relation("TrainerThemeSettings", fields: [theme_id], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "trainer_settings_theme_id_fkey")

  @@index([theme_id], map: "trainer_settings_theme_id_fkey")
  @@map("trainer_settings")
}

model TrainerCourse {
  id         BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  quiz_id    Int
  webinar_id Int
  created_at Int     @db.UnsignedInt
  quiz       Quizzes @relation("TrainerCourses", fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "trainer_courses_quiz_id_fkey")
  webinar    Webinar @relation("WebinarTrainerCourses", fields: [webinar_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "trainer_courses_webinar_id_fkey")

  @@unique([quiz_id, webinar_id], map: "uniq_tc_quiz_webinar")
  @@index([webinar_id, quiz_id], map: "idx_tc_webinar_quiz")
  @@map("trainer_courses")
}

model TrainerAttempt {
  id                    BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  quiz_id               Int
  user_id               Int
  quiz_version_at_start Int
  mode                  TrainerAttemptMode       @default(trainer)
  attempt_number        Int?                     @db.UnsignedInt
  status                TrainerAttemptStatus     @default(in_progress)
  score                 Int                      @default(0) @db.UnsignedInt
  max_score             Int                      @default(0) @db.UnsignedInt
  correct_count         Int                      @default(0) @db.UnsignedInt
  incorrect_count       Int                      @default(0) @db.UnsignedInt
  skipped_count         Int                      @default(0) @db.UnsignedInt
  current_round         Int                      @default(1) @db.UnsignedInt
  current_position      Int                      @default(0) @db.UnsignedInt
  started_at            Int                      @db.UnsignedInt
  finished_at           Int?                     @db.UnsignedInt
  elapsed_sec           Int                      @default(0) @db.UnsignedInt
  paused_at             Int?                     @db.UnsignedInt
  settings_snapshot     Json
  created_at            Int                      @db.UnsignedInt
  updated_at            Int?                     @db.UnsignedInt
  questions             TrainerAttemptQuestion[] @relation("TrainerAttemptQuestions")
  quiz                  Quizzes                  @relation("TrainerAttempts", fields: [quiz_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "trainer_attempts_quiz_id_fkey")
  user                  User                     @relation("TrainerAttemptUser", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "trainer_attempts_user_id_fkey")

  @@unique([quiz_id, user_id, mode, attempt_number], map: "uniq_ta_quiz_user_mode_no")
  @@index([quiz_id, mode, status, started_at], map: "idx_ta_quiz_mode_status_started")
  @@index([user_id, quiz_id, mode, started_at], map: "idx_ta_user_quiz_mode_started")
  @@map("trainer_attempts")
}

model TrainerAttemptQuestion {
  id                BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  attempt_id        BigInt                 @db.UnsignedBigInt
  question_id       Int?
  question_snapshot Json
  round_number      Int                    @db.UnsignedInt
  position          Int                    @db.UnsignedInt
  answer_payload    Json?
  outcome           TrainerQuestionOutcome @default(pending)
  points_awarded    Int                    @default(0) @db.UnsignedInt
  answered_at       Int?                   @db.UnsignedInt
  time_spent_sec    Int?                   @db.UnsignedInt
  /// Phase 41 — server-owned per-question deadline (unix sec); NULL when the trainer has no timer.
  deadline_at       Int?                   @db.UnsignedInt
  created_at        Int                    @db.UnsignedInt
  updated_at        Int?                   @db.UnsignedInt
  attempt           TrainerAttempt         @relation("TrainerAttemptQuestions", fields: [attempt_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "trainer_attempt_questions_attempt_id_fkey")
  question          QuizQuestion?          @relation("TrainerQuestionProvenance", fields: [question_id], references: [id], onUpdate: Restrict, map: "trainer_attempt_questions_question_id_fkey")

  @@unique([attempt_id, round_number, position], map: "uniq_taq_attempt_round_pos")
  @@unique([attempt_id, round_number, question_id], map: "uniq_taq_attempt_round_question")
  @@index([question_id], map: "idx_taq_question")
  @@map("trainer_attempt_questions")
}

model Publisher {
  id         Int    @id @default(autoincrement())
  name       String @unique(map: "uniq_publishers_name") @db.VarChar(255)
  created_at Int
  updated_at Int?
  books      Book[] @relation("PublisherBooks")

  @@map("publishers")
}

model Book {
  id               Int                   @id @default(autoincrement())
  subject_id       Int?
  publisher_id     Int?
  grade            Int?                  @db.UnsignedTinyInt
  language         String                @default("kz") @db.VarChar(8)
  /// Phase 42 — author credit line as printed on the cover; display only.
  authors          String?               @db.VarChar(512)
  year             Int?                  @db.SmallInt
  cover_image      String?               @db.VarChar(512)
  page_count       Int                   @default(0)
  source_file_url  String?               @db.VarChar(512)
  status           BookStatus            @default(draft)
  created_at       Int
  updated_at       Int?
  deleted_at       Int?
  bookmarks        BookBookmark[]        @relation("BookBookmarks")
  highlights       BookHighlight[]       @relation("BookHighlights")
  pages            BookPage[]            @relation("BookPages")
  reading_progress BookReadingProgress[] @relation("BookReadingProgress")
  translations     BookTranslation[]     @relation("BookTranslations")
  publisher        Publisher?            @relation("PublisherBooks", fields: [publisher_id], references: [id], onUpdate: Restrict, map: "books_publisher_id_fkey")
  subject          QuizSubject?          @relation("QuizSubjectBooks", fields: [subject_id], references: [id], onUpdate: Restrict, map: "books_subject_id_fkey")

  @@index([status], map: "idx_books_status")
  @@index([subject_id, publisher_id, grade], map: "idx_books_facets")
  @@index([publisher_id], map: "books_publisher_id_fkey")
  @@map("books")
}

model BookTranslation {
  id          Int     @id @default(autoincrement())
  book_id     Int
  locale      String
  title       String  @db.VarChar(512)
  description String? @db.Text
  book        Book    @relation("BookTranslations", fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_translations_book_id_fkey")

  @@index([book_id], map: "idx_bt_book")
  @@map("book_translations")
}

model BookPage {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  book_id      Int
  page_number  Int
  image_url    String? @db.VarChar(512)
  text_content String? @db.MediumText
  created_at   Int
  updated_at   Int?
  book         Book    @relation("BookPages", fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_pages_book_id_fkey")

  @@unique([book_id, page_number], map: "uniq_bp_book_page")
  @@map("book_pages")
}

model BookBookmark {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     Int
  book_id     Int
  page_number Int
  note        String? @db.VarChar(255)
  created_at  Int
  book        Book    @relation("BookBookmarks", fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_bookmarks_book_id_fkey")
  user        User    @relation("UserBookBookmarks", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_bookmarks_user_id_fkey")

  @@unique([user_id, book_id, page_number], map: "uniq_bb_user_book_page")
  @@index([user_id], map: "idx_bb_user")
  @@index([book_id], map: "book_bookmarks_book_id_fkey")
  @@map("book_bookmarks")
}

model BookReadingProgress {
  user_id    Int
  book_id    Int
  last_page  Int  @default(1)
  updated_at Int
  book       Book @relation("BookReadingProgress", fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_reading_progress_book_id_fkey")
  user       User @relation("UserBookReadingProgress", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_reading_progress_user_id_fkey")

  @@id([user_id, book_id])
  @@index([book_id], map: "book_reading_progress_book_id_fkey")
  @@map("book_reading_progress")
}

model BookHighlight {
  id          BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  user_id     Int
  book_id     Int
  page_number Int
  shape       Json
  color       String @default("yellow") @db.VarChar(16)
  created_at  Int
  updated_at  Int?
  deleted_at  Int?
  book        Book   @relation("BookHighlights", fields: [book_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_highlights_book_id_fkey")
  user        User   @relation("UserBookHighlights", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "book_highlights_user_id_fkey")

  @@index([user_id, book_id, page_number], map: "idx_bh_user_book_page")
  @@index([book_id], map: "book_highlights_book_id_fkey")
  @@map("book_highlights")
}

model QuizBadge {
  id               Int         @id @default(autoincrement())
  is_active        Boolean     @default(true)
  quiz_category_id Int?
  price            Decimal?    @db.Decimal(15, 3)
  is_paid          Boolean     @default(false)
  access_days      Int?        @db.UnsignedInt
  is_listed        Boolean     @default(true)
  created_at       DateTime    @default(now()) @db.Timestamp(0)
  updated_at       DateTime?   @db.Timestamp(0)
  cart             Cart[]
  order_items      OrderItem[]

  @@map("quiz_badges")
}

model QuizBadgeTranslation {
  id            Int       @id @default(autoincrement())
  quiz_badge_id Int
  locale        String
  title         String    @db.VarChar(255)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)

  @@map("quiz_badge_translations")
}

model QuizBadgeItem {
