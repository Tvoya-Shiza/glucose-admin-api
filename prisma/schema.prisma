model Credit {
  id           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  course_id    Int
  chapter_id   Int
  group_id     Int                @db.UnsignedInt
  title        String             @db.VarChar(255)
  description  String?            @db.Text
  scheduled_at Int?               @db.UnsignedInt
  status       CreditStatus       @default(active)
  created_by   Int
  created_at   Int                @db.UnsignedInt
  updated_at   Int?               @db.UnsignedInt
  deleted_at   Int?               @db.UnsignedInt
  launches     CreditLaunch[]     @relation("CreditLaunches")
  links        CreditLessonLink[] @relation("CreditLessonLinks")
  sessions     CreditSession[]    @relation("CreditSessions")
  chapter      WebinarChapter     @relation("ChapterCredits", fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  course       Webinar            @relation("WebinarCredits", fields: [course_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  creator      User               @relation("CreditCreator", fields: [created_by], references: [id], onUpdate: Restrict)
  group        Group              @relation("GroupCredits", fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([course_id, chapter_id], map: "idx_cr_course_chapter")
  @@index([group_id, status, deleted_at], map: "idx_cr_group_status")
  @@index([scheduled_at], map: "idx_cr_scheduled")
  @@index([chapter_id], map: "credits_chapter_id_fkey")
  @@index([created_by], map: "credits_created_by_fkey")
  @@map("credits")
}

model CreditLessonLink {
  id              BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  credit_id       BigInt             @db.UnsignedBigInt
  chapter_item_id Int
  created_at      Int                @db.UnsignedInt
  chapter_item    WebinarChapterItem @relation("ChapterItemCreditLinks", fields: [chapter_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  credit          Credit             @relation("CreditLessonLinks", fields: [credit_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([credit_id, chapter_item_id], name: "uniq_cll_credit_item", map: "uniq_cll_credit_item")
  @@index([chapter_item_id], map: "idx_cll_item")
  @@map("credit_lesson_links")
}

model CreditLaunch {
  id                  BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  credit_id           BigInt             @db.UnsignedBigInt
  curator_id          Int
  topic_ids           Json
  question_count      Int                @default(5) @db.UnsignedInt
  difficulty_template Json
  duration_sec        Int                @default(420) @db.UnsignedInt
  pass_type           CreditPassType     @default(percent)
  pass_value          Int                @default(50) @db.UnsignedInt
  status              CreditLaunchStatus @default(active)
  created_at          Int                @db.UnsignedInt
  credit              Credit             @relation("CreditLaunches", fields: [credit_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  curator             User               @relation("CreditLaunchCurator", fields: [curator_id], references: [id], onUpdate: Restrict)
  sessions            CreditSession[]    @relation("CreditLaunchSessions")

  @@index([credit_id, created_at], map: "idx_cl_credit")
  @@index([curator_id, created_at], map: "idx_cl_curator")
  @@map("credit_launches")
}

model CreditSession {
  id               BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  launch_id        BigInt                  @db.UnsignedBigInt
  credit_id        BigInt                  @db.UnsignedBigInt
  student_id       Int
  attempt_number   Int                     @db.UnsignedInt
  status           CreditSessionStatus     @default(pending)
  current_position Int?                    @db.UnsignedInt
  started_at       Int?                    @db.UnsignedInt
  ends_at          Int?                    @db.UnsignedInt
  finished_at      Int?                    @db.UnsignedInt
  score            Int?                    @db.UnsignedInt
  max_score        Int                     @db.UnsignedInt
  pass_threshold   Int                     @db.UnsignedInt
  passed           Boolean?
  retake_at        Int?                    @db.UnsignedInt
  created_at       Int                     @db.UnsignedInt
  questions        CreditSessionQuestion[] @relation("CreditSessionQuestions")
  credit           Credit                  @relation("CreditSessions", fields: [credit_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  launch           CreditLaunch            @relation("CreditLaunchSessions", fields: [launch_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  student          User                    @relation("CreditSessionStudent", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([launch_id, student_id], name: "uniq_cs_launch_student", map: "uniq_cs_launch_student")
  @@unique([credit_id, student_id, attempt_number], name: "uniq_cs_attempt", map: "uniq_cs_attempt")
  @@index([credit_id, student_id, passed], map: "idx_cs_gate")
  @@index([student_id, status], map: "idx_cs_student")
  @@index([status, ends_at], map: "idx_cs_sweep")
  @@index([student_id, retake_at], map: "idx_cs_retake")
  @@map("credit_sessions")
}

model CreditSessionQuestion {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  session_id     BigInt             @db.UnsignedBigInt
  question_id    BigInt?            @db.UnsignedBigInt
  topic_id       BigInt?            @db.UnsignedBigInt
  position       Int                @db.UnsignedInt
  difficulty     CreditDifficulty
  question       String             @db.Text
  answer         String             @db.Text
  question_image String?            @db.Text
  answer_image   String?            @db.Text
  score          Int                @db.UnsignedInt
  mark           CreditQuestionMark @default(pending)
  marked_at      Int?               @db.UnsignedInt
  marked_by      Int?
  bank_question  CreditQuestion?    @relation("CreditQuestionSnapshots", fields: [question_id], references: [id], onUpdate: Restrict)
  session        CreditSession      @relation("CreditSessionQuestions", fields: [session_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([session_id, position], name: "uniq_csq_session_pos", map: "uniq_csq_session_pos")
  @@index([question_id], map: "credit_session_questions_question_id_fkey")
  @@map("credit_session_questions")
}

model RatingJournal {
  id         BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  group_id   Int                   @db.UnsignedInt
  course_id  Int
  title      String                @db.VarChar(255)
  created_by Int
  created_at Int                   @db.UnsignedInt
  updated_at Int?                  @db.UnsignedInt
  deleted_at Int?                  @db.UnsignedInt
  columns    RatingJournalColumn[] @relation("RatingJournalColumns")
  course     Webinar               @relation("WebinarRatingJournals", fields: [course_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  creator    User                  @relation("RatingJournalCreator", fields: [created_by], references: [id], onUpdate: Restrict)
  group      Group                 @relation("GroupRatingJournals", fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([group_id, course_id], name: "uniq_rj_group_course", map: "uniq_rj_group_course")
  @@index([group_id], map: "idx_rj_group")
  @@index([course_id], map: "rating_journals_course_id_fkey")
  @@index([created_by], map: "rating_journals_created_by_fkey")
  @@map("rating_journals")
}

model RatingJournalColumn {
  id            BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  journal_id    BigInt                  @db.UnsignedBigInt
  title         String                  @db.VarChar(255)
  source_kind   RatingJournalSourceKind
  source_ref_id BigInt?                 @db.UnsignedBigInt
  chapter_id    Int?
  max_score     Int                     @db.UnsignedInt
  position      Int                     @default(0) @db.UnsignedInt
  is_hidden     Boolean                 @default(false)
  created_by    Int
  created_at    Int                     @db.UnsignedInt
  updated_at    Int?                    @db.UnsignedInt
  deleted_at    Int?                    @db.UnsignedInt
  cells         RatingJournalCell[]     @relation("RatingJournalCells")
  chapter       WebinarChapter?         @relation("ChapterRatingJournalColumns", fields: [chapter_id], references: [id], onUpdate: Restrict)
  creator       User                    @relation("RatingJournalColumnCreator", fields: [created_by], references: [id], onUpdate: Restrict)
  journal       RatingJournal           @relation("RatingJournalColumns", fields: [journal_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([journal_id, source_kind, source_ref_id], name: "uniq_rjc_source", map: "uniq_rjc_source")
  @@index([journal_id, position], map: "idx_rjc_journal_pos")
  @@index([chapter_id], map: "rating_journal_columns_chapter_id_fkey")
  @@index([created_by], map: "rating_journal_columns_created_by_fkey")
  @@map("rating_journal_columns")
}

model RatingJournalCell {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  column_id          BigInt              @db.UnsignedBigInt
  student_id         Int
  value              Int?                @db.UnsignedInt
  is_manual_override Boolean             @default(false)
  source_session_id  BigInt?             @db.UnsignedBigInt
  updated_by         Int?
  updated_at         Int                 @db.UnsignedInt
  column             RatingJournalColumn @relation("RatingJournalCells", fields: [column_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  student            User                @relation("RatingJournalCellStudent", fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([column_id, student_id], name: "uniq_rjcell_col_student", map: "uniq_rjcell_col_student")
  @@index([student_id], map: "idx_rjcell_student")
  @@map("rating_journal_cells")
}

model RatingJournalCellHistory {
  id         BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  cell_id    BigInt?                 @db.UnsignedBigInt
  column_id  BigInt                  @db.UnsignedBigInt
  student_id Int
  old_value  Int?                    @db.UnsignedInt
  new_value  Int?                    @db.UnsignedInt
  source     RatingJournalCellSource
  changed_by Int?
  changed_at Int                     @db.UnsignedInt

  @@index([column_id, student_id, changed_at], map: "idx_rjch_lookup")
  @@map("rating_journal_cell_history")
}

model manual_migrations {
  name       String   @id @db.VarChar(190)
  checksum   String   @db.Char(64)
