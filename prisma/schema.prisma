}

model user_streaks {
  user_id          Int       @id
  current_streak   Int       @default(0)
  longest_streak   Int       @default(0)
  last_activity_at DateTime?
  updated_at       DateTime  @default(now())
  users            User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
}

