/// Phase 29 — bridge: a single chapter item (type='file', PDF block) → many
/// PDF `files` rows, ordered. Mirrors the canonical glucose-api schema.
model WebinarChapterItemPdfFile {
  id                      Int                @id @default(autoincrement())
  webinar_chapter_item_id Int
  file_id                 Int
  sort_order              Int                @default(0)
  created_at              Int
  file                    Files              @relation("PdfFileLinks", fields: [file_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wcipf_file")
  chapter_item            WebinarChapterItem @relation("ChapterItemPdfFiles", fields: [webinar_chapter_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wcipf_item")

  @@unique([webinar_chapter_item_id, file_id], map: "uniq_wcipf_item_file")
  @@index([webinar_chapter_item_id], map: "idx_wcipf_item")
  @@index([file_id], map: "fk_wcipf_file")
  @@map("webinar_chapter_item_pdf_files")
}

/// Phase 30 — bridge: up to 3 lecture-notes attachments (any document type) for a
/// chapter item, ordered. Independent of item_id (the main file). Mirrors the
/// canonical glucose-api schema. Refresh via `npm run prisma:pull`.
model WebinarChapterItemAttachment {
  id                      Int                @id @default(autoincrement())
  webinar_chapter_item_id Int
  file_id                 Int
  sort_order              Int                @default(0)
  created_at              Int
  file                    Files              @relation("AttachmentFileLinks", fields: [file_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wcia_file")
  chapter_item            WebinarChapterItem @relation("ChapterItemAttachments", fields: [webinar_chapter_item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_wcia_item")

  @@unique([webinar_chapter_item_id, file_id], map: "uniq_wcia_item_file")
  @@index([webinar_chapter_item_id], map: "idx_wcia_item")
  @@index([file_id], map: "fk_wcia_file")
  @@map("webinar_chapter_item_attachments")
}

/// Phase 19 — per-item content unlock gates.
///
/// Granted by an admin to either a single user OR a single group (xor — enforced
/// at the application layer in progress-overrides.service.ts; a DB-level CHECK
/// would conflict with the CASCADE FKs per MySQL 8 error 3823). The two composite
/// UNIQUE indexes (uniq_cco_user_course_item, uniq_cco_group_course_item) also
/// prevent duplicate grants per (target, course, item). When evaluating "can view
/// item N": course access exists AND (strict_progress=false OR previous items
/// completed OR a matching override row exists).
///
/// NEVER writes to CourseLearning.passed — pure access gate.
///
/// expires_at is NULL for perpetual unlocks. When set, view-time check ignores
/// rows past their expiry.
model CourseContentOverride {
  id                  Int                @id @default(autoincrement()) @db.UnsignedInt
  user_id             Int?
  group_id            Int?               @db.UnsignedInt
  webinar_id          Int
  item_id             Int
  granted_by_admin_id Int?
  note                String?            @db.VarChar(255)
  created_at          Int                @db.UnsignedInt
  expires_at          Int?               @db.UnsignedInt
  granted_by_admin    User?              @relation("AdminGrantedContentOverrides", fields: [granted_by_admin_id], references: [id], onUpdate: Restrict, map: "fk_cco_granted_by")
  group               Group?             @relation("GroupContentOverrides", fields: [group_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cco_group")
  item                WebinarChapterItem @relation("ItemContentOverrides", fields: [item_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cco_item")
  user                User?              @relation("UserContentOverrides", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cco_user")
  webinar             Webinar            @relation("WebinarContentOverrides", fields: [webinar_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_cco_webinar")

  @@unique([user_id, webinar_id, item_id], name: "uniq_cco_user_course_item", map: "uniq_cco_user_course_item")
  @@unique([group_id, webinar_id, item_id], name: "uniq_cco_group_course_item", map: "uniq_cco_group_course_item")
  @@index([user_id, webinar_id], map: "idx_cco_user_course")
  @@index([group_id, webinar_id], map: "idx_cco_group_course")
  @@index([granted_by_admin_id], map: "fk_cco_granted_by")
  @@index([expires_at], map: "idx_cco_expires_at")
  @@index([item_id], map: "idx_cco_item")
  @@index([webinar_id], map: "idx_cco_webinar")
  @@map("course_content_overrides")
}

